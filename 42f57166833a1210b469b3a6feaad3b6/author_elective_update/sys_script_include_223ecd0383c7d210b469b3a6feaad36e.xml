        <name>RaasReviewQualifier</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var RaasReviewQualifier = Class.create();
RaasReviewQualifier.prototype = {
    initialize: function() {
    },

	canReview:function(){
		var grMediaReviews = new GlideRecord("x_1593190_raas_review");
		grMediaReviews.addQuery("media", current.getUniqueValue());
		grMediaReviews.query();
		var hasUserReview = false;
		while(grMediaReview.next()){
			if(grMediaReviews.getValue("sys_created_by") == gs.getUserID() && grMediaReviews.getValue("state").toString() == "4"){
				hasUserReview = true;
			}
		}
		if(hasUserReview && current.state.toString() == "3") return current;
	},

    type: 'RaasReviewQualifier'
};]]></script>
